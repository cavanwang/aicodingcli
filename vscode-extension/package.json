{
  "name": "aicoding-assistant",
  "displayName": "AI Coding Assistant",
  "description": "AI 编程助手 — 聊天式代码编辑",
  "version": "0.1.0",
  "publisher": "aicoding",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aicoding.startChat",
        "title": "AI Coding: 打开聊天面板"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aicoding-sidebar",
          "title": "AI Coding",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "aicoding-sidebar": [
        {
          "type": "webview",
          "id": "aicoding.chatView",
          "name": "聊天"
        }
      ]
    },
    "configuration": {
      "title": "AI Coding Assistant",
      "properties": {
        "aicoding.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python 解释器路径"
        },
        "aicoding.projectPath": {
          "type": "string",
          "default": "",
          "description": "Agent 工作目录（默认使用当前工作区根目录）"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
